<?xml version="1.0" ?>
<sdf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.4"
     xmlns="https://sdformat.org/"
     xsi:schemaLocation="https://sdformat.org/ http://sdformat.org/schemas/root.xsd">
    <world name="outdoor">
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

        <!-- Navsat plugin -->
        <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

        <gui>
            <camera name="user_camera">
                <pose>-10 -5 5 0 0 0</pose>
            </camera>
        </gui>

        <scene>
            <ambient>0.2 0.2 0.2 1.0</ambient>
            <grid>false</grid>
            <shadows>false</shadows>
            <!-- <sky> -->
            <!--     <clouds> -->
            <!--         <speed>4</speed> -->
            <!--     </clouds> -->
            <!-- </sky> -->
        </scene>

        <!-- &lt;!&ndash; Only one ROS interface plugin is required per world, as any other plugin can connect a Gazebo -->
        <!--      topic to a ROS topic (or vise versa). &ndash;&gt; -->
        <!-- <plugin name="ros_interface_plugin" filename="librotors_gazebo_ros_interface_plugin.so"/> -->

        <!-- <physics type='ode'> -->
        <!--     <ode> -->
        <!--         <solver> -->
        <!--             <type>quick</type> -->
        <!--             <iters>1000</iters> -->
        <!--             <sor>1.3</sor> -->
        <!--         </solver> -->
        <!--         <constraints> -->
        <!--             <cfm>0</cfm> -->
        <!--             <erp>0.2</erp> -->
        <!--             <contact_max_correcting_vel>100</contact_max_correcting_vel> -->
        <!--             <contact_surface_layer>0.001</contact_surface_layer> -->
        <!--         </constraints> -->
        <!--     </ode> -->
        <!--     <max_step_size>0.01</max_step_size> -->
        <!--     <real_time_factor>1</real_time_factor> -->
        <!--     <real_time_update_rate>100</real_time_update_rate> -->
        <!--     <gravity>0 0 -9.8</gravity> -->
        <!-- </physics> -->
        <!-- <physics name="1ms" type="ignored"> -->
        <!--     <dart> -->
        <!--         <collision_detector>bullet</collision_detector> -->
        <!--     </dart> -->
        <!--     <max_step_size>0.001</max_step_size> -->
        <!--     <real_time_factor>1.0</real_time_factor> -->
        <!-- </physics> -->
        <physics type="ode">
            <real_time_update_rate>1000.0</real_time_update_rate>
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <ode>
                <solver>
                    <type>quick</type>
                    <iters>100</iters> <!-- 1000 -> 150 -> 100 -->
                    <precon_iters>0</precon_iters>
                    <sor>1.400000</sor>
                    <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
                </solver>
                <constraints>
                    <cfm>0.00001</cfm>
                    <erp>0.2</erp>
                    <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
                    <contact_surface_layer>0.01000</contact_surface_layer>
                </constraints>
            </ode>
        </physics>

        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <world_frame_orientation>ENU</world_frame_orientation>
            <latitude_deg>45.496651</latitude_deg>
            <longitude_deg>-73.5780812</longitude_deg>
            <elevation>0</elevation>
            <heading_deg>0</heading_deg>
        </spherical_coordinates>

        <include>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
            <pose>0 0 100 0 0 0</pose>
        </include>

        <!-- <include>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
            <pose>0 0 0 0 0 0</pose>
        </include> -->

        <include>
            <static>false</static>
            <name>ArUco Tag A</name>
            <pose>5 5 0 0 0 ${-pi}</pose>
            <uri>model://aruco_post_0</uri>
        </include>

        <include>
            <static>false</static>
            <name>ArUco Tag B</name>
            <pose>5 0 0 0 0 0</pose>
            <uri>model://aruco_post_1</uri>
        </include>

        <model name="ground plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>1000 1000</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- TODO 2025-11-25 (Will Free): If I ever need to do this shit again, I'm just gonna write a program for this    -->

        <!-- <model name='maze'>
            <pose>0 0 0 0 0 0</pose>

            <xacro:maze scale="2.0"/>

            <static>true</static>
            <self_collide>false</self_collide>
        </model> -->
    </world>
</sdf>

