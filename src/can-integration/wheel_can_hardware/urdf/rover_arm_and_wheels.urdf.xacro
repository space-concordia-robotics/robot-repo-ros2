<?xml version="1.0"?>
<!--
  Combined robot description: arm (ArmCanInterface) + six-wheel drive (WheelCanInterface).

  Both hardware plugins share the same SocketCAN interface via getSharedCanController().
  Do NOT also launch a legacy can_node on the same interface — it would open a second
  raw socket and interfere with ros2_control CAN traffic.

  Launch via:
    ros2 launch wheel_can_hardware rover_arm_and_wheels.launch.py can_interface:=can0
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_arm_and_wheels">
  <xacro:arg name="can_interface"            default="can0"/>
  <xacro:arg name="initial_positions_file"   default="$(find rover_arm_moveit_config)/config/initial_positions.yaml"/>

  <!-- Rover body root link. Arm attaches here; wheels attach here. -->
  <link name="base_link">
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <!-- Arm description (joints 1-5, spin servo, gripper geometry). -->
  <xacro:include filename="$(find rover_arm_description)/urdf/arm.xacro"/>
  <xacro:include filename="$(find rover_arm_description)/urdf/gripper.xacro"/>
  <xacro:include filename="$(find rover_arm_description)/urdf/common_properties.xacro"/>

  <!-- Attach arm base_structure_link to rover body. -->
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_structure_link"/>
    <origin xyz="0.2 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- Gripper fixed joint (from rover_arm.urdf.xacro). -->
  <joint name="joint7" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_claw_link"/>
    <origin xyz="0.005725 0 0.07" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Wheel links (minimal kinematic geometry). -->
  <xacro:macro name="wheel_link" params="joint_name link_name xyz">
    <link name="${link_name}">
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="${joint_name}" type="continuous">
      <parent link="base_link"/>
      <child link="${link_name}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel_link joint_name="wheel_right_front" link_name="wheel_right_front_link" xyz=" 0.4 -0.6 0"/>
  <xacro:wheel_link joint_name="wheel_right_mid"   link_name="wheel_right_mid_link"   xyz=" 0.0 -0.6 0"/>
  <xacro:wheel_link joint_name="wheel_right_rear"  link_name="wheel_right_rear_link"  xyz="-0.4 -0.6 0"/>
  <xacro:wheel_link joint_name="wheel_left_front"  link_name="wheel_left_front_link"  xyz=" 0.4  0.6 0"/>
  <xacro:wheel_link joint_name="wheel_left_mid"    link_name="wheel_left_mid_link"    xyz=" 0.0  0.6 0"/>
  <xacro:wheel_link joint_name="wheel_left_rear"   link_name="wheel_left_rear_link"   xyz="-0.4  0.6 0"/>

  <!-- Arm ros2_control hardware block (ArmCanInterface). -->
  <xacro:include filename="$(find rover_arm_moveit_config)/config/rover_arm.ros2_control.xacro"/>
  <xacro:rover_arm_ros2_control
      name="RoverArm"
      initial_positions_file="$(arg initial_positions_file)"/>

  <!-- Wheel ros2_control hardware block (WheelCanInterface). -->
  <xacro:include filename="$(find wheel_can_hardware)/urdf/rover_wheels.ros2_control.xacro"/>
  <xacro:rover_wheels_ros2_control
      name="RoverWheels"
      can_interface="$(arg can_interface)"/>

</robot>
