<?xml version="1.0" ?>
<sdf version="1.4" xmlns="https://sdformat.org/"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xmlns:xacro="https://ros.org/wiki/xacro"
     xsi:schemaLocation="https://sdformat.org/ http://sdformat.org/schemas/root.xsd https://ros.org/wiki/xacro ../../ceres_urdf/xacro.xsd">
    <world name="outdoor">
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

        <gui>
            <camera name="user_camera">
                <pose>-10 -5 5 0 0 0</pose>
            </camera>
        </gui>

        <scene>
            <ambient>0.2 0.2 0.2 1.0</ambient>
            <grid>false</grid>
            <shadows>false</shadows>
            <!-- <sky> -->
            <!--     <clouds> -->
            <!--         <speed>4</speed> -->
            <!--     </clouds> -->
            <!-- </sky> -->
        </scene>

        <!-- &lt;!&ndash; Only one ROS interface plugin is required per world, as any other plugin can connect a Gazebo -->
        <!--      topic to a ROS topic (or vise versa). &ndash;&gt; -->
        <!-- <plugin name="ros_interface_plugin" filename="librotors_gazebo_ros_interface_plugin.so"/> -->

        <!-- <physics type='ode'> -->
        <!--     <ode> -->
        <!--         <solver> -->
        <!--             <type>quick</type> -->
        <!--             <iters>1000</iters> -->
        <!--             <sor>1.3</sor> -->
        <!--         </solver> -->
        <!--         <constraints> -->
        <!--             <cfm>0</cfm> -->
        <!--             <erp>0.2</erp> -->
        <!--             <contact_max_correcting_vel>100</contact_max_correcting_vel> -->
        <!--             <contact_surface_layer>0.001</contact_surface_layer> -->
        <!--         </constraints> -->
        <!--     </ode> -->
        <!--     <max_step_size>0.01</max_step_size> -->
        <!--     <real_time_factor>1</real_time_factor> -->
        <!--     <real_time_update_rate>100</real_time_update_rate> -->
        <!--     <gravity>0 0 -9.8</gravity> -->
        <!-- </physics> -->
        <!-- <physics name="1ms" type="ignored"> -->
        <!--     <dart> -->
        <!--         <collision_detector>bullet</collision_detector> -->
        <!--     </dart> -->
        <!--     <max_step_size>0.001</max_step_size> -->
        <!--     <real_time_factor>1.0</real_time_factor> -->
        <!-- </physics> -->
        <physics type="ode">
            <real_time_update_rate>1000.0</real_time_update_rate>
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1</real_time_factor>
            <ode>
                <solver>
                    <type>quick</type>
                    <iters>150</iters>
                    <precon_iters>0</precon_iters>
                    <sor>1.400000</sor>
                    <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
                </solver>
                <constraints>
                    <cfm>0.00001</cfm>
                    <erp>0.2</erp>
                    <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
                    <contact_surface_layer>0.01000</contact_surface_layer>
                </constraints>
            </ode>
        </physics>

        <include>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
            <pose>0 0 100 0 0 0</pose>
        </include>

        <include>
            <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
            <pose>0 0 0 0 0 0</pose>
        </include>

        <xacro:macro name="wall" params="name x y facing length">
            <xacro:property name="size_x" value="${0.1 if facing == 'y' else length * 2}"/>
            <xacro:property name="size_y" value="${0.1 if facing == 'x' else length * 2}"/>

            <!-- <model name='${name}'> -->
            <!--     <pose>${x * 2} ${y * 2} 1 0 0 0</pose> -->
            <!--     <link name='box_link'> -->
            <link name="${name}">
                <gravity>false</gravity>
                <collision name='box_collision'>
                    <geometry>
                        <box>
                            <size>${size_x} ${size_y} 2</size>
                        </box>
                    </geometry>
                </collision>
                <collision name='box_collision2'>
                    <geometry>
                        <box>
                            <size>0.5 0.5 2</size>
                        </box>
                    </geometry>
                    <pose>${length/2 if facing == 'x' else 0} ${length/2 if facing == 'y' else 0} 0 0 0 0</pose>
                </collision>
                <collision name='box_collision3'>
                    <geometry>
                        <box>
                            <size>0.5 0.5 2</size>
                        </box>
                    </geometry>
                    <pose>${-length/2 if facing == 'x' else 0} ${-length/2 if facing == 'y' else 0} 0 0 0 0</pose>
                </collision>
                <visual name='box_visual'>
                    <geometry>
                        <box>
                            <size>${size_x} ${size_y} 2</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                        <specular>1 1 1 1</specular>
                    </material>
                </visual>
                <visual name='box_visual2'>
                    <geometry>
                        <box>
                            <size>0.5 0.5 2</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                        <specular>1 1 1 1</specular>
                    </material>
                    <pose>${length/2 if facing == 'x' else 0} ${length/2 if facing == 'y' else 0} 0 0 0 0</pose>
                </visual>
                <visual name='box_visual3'>
                    <geometry>
                        <box>
                            <size>0.5 0.5 2</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                        <specular>1 1 1 1</specular>
                    </material>
                    <pose>${-length/2 if facing == 'x' else 0} ${-length/2 if facing == 'y' else 0} 0 0 0 0</pose>
                </visual>
                <pose>${x * 2} ${y * 2} 1 0 0 0</pose>
                <!-- <pose>0 0 0 0 0 0</pose> -->
                <enable_wind>false</enable_wind>
            </link>
            <!-- <static>true</static> -->
            <!-- <self_collide>false</self_collide> -->
            <!-- </model> -->
        </xacro:macro>

        <!-- TODO 2025-11-25 (Will Free): If I ever need to do this shit again, I'm just gonna write a program for this    -->

        <model name='maze'>
            <pose>0 0 0 0 0 0</pose>
            <xacro:wall name="entrance_1" x="-1" y="0" facing="y" length="2"/>
            <xacro:wall name="entrance_2" x="0.25" y="-1" facing="x" length="2.5"/>
            <xacro:wall name="entrance_3" x="0.25" y="1" facing="x" length="2.5"/>
            <xacro:wall name="entrance_4" x="1.5" y="2" facing="y" length="3"/>
            <xacro:wall name="entrance_5" x="1.5" y="-2" facing="y" length="3"/>

            <xacro:wall name="outer_wall_1" x="5" y="-3.5" facing="x" length="7"/>
            <xacro:wall name="outer_wall_2" x="5" y="3.5" facing="x" length="7"/>

            <xacro:wall name="exit_1" x="8.5" y="2" facing="y" length="3"/>
            <xacro:wall name="exit_2" x="8.5" y="-2" facing="y" length="3"/>

            <xacro:wall name="inner_wall_1" x="2" y="0.5" facing="x" length="1"/>
            <xacro:wall name="inner_wall_2" x="2" y="-1.5" facing="x" length="1"/>
            <xacro:wall name="inner_wall_3" x="4.5" y="0.5" facing="x" length="2"/>
            <xacro:wall name="inner_wall_4" x="4.5" y="1.5" facing="x" length="2"/>
            <xacro:wall name="inner_wall_5" x="7.5" y="-1.5" facing="x" length="2"/>
            <xacro:wall name="inner_wall_6" x="4" y="-1.5" facing="x" length="1"/>
            <xacro:wall name="inner_wall_7" x="7" y="2.5" facing="x" length="1"/>
            <xacro:wall name="inner_wall_8" x="8" y="0.5" facing="x" length="1"/>

            <xacro:wall name="inner_wall_9" x="2.5" y="-2" facing="y" length="1"/>
            <xacro:wall name="inner_wall_10" x="3.5" y="-3" facing="y" length="1"/>
            <xacro:wall name="inner_wall_11" x="3.5" y="2" facing="y" length="1"/>
            <xacro:wall name="inner_wall_12" x="2.5" y="2.5" facing="y" length="2"/>
            <xacro:wall name="inner_wall_13" x="4.5" y="-1.5" facing="y" length="2"/>
            <xacro:wall name="inner_wall_14" x="6.5" y="3" facing="y" length="1"/>
            <xacro:wall name="inner_wall_15" x="6.5" y="-0.5" facing="y" length="4"/>
            <xacro:wall name="inner_wall_16" x="7.5" y="0" facing="y" length="1"/>
            <xacro:wall name="inner_wall_17" x="7.5" y="-3" facing="y" length="1"/>

            <static>true</static>
            <self_collide>false</self_collide>
        </model>
    </world>
</sdf>

