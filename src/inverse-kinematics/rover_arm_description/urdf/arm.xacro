<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


    <link name="base_structure_link">
        <visual>
            <geometry>
                <box size="0.30670 0.1600 0.135"/> 
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 1.57" />
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.30670 0.1600 0.135"/> 
            </geometry>
            <material name="blue"/>
        </collision>
    </link>

    <link name="base_pivot_link">
        <visual>
            <geometry>
                <box size="0.1633 0.1633 0.1633"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.1633 0.1633 0.1633"/>
            </geometry>
            <material name="red"/>
        </collision>
    </link>

    <link name="bicep_tube_link">
        <visual>
            <geometry>
                <cylinder radius="0.0348" length="0.508"/>
            </geometry>
            <origin xyz="0 0 0.220" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.0348" length="0.508"/>
            </geometry>
            <material name="grey"/>
        </collision>
    </link>

    <link name="bicep_gearbox_link">
        <visual>
            <geometry>
                <box size="0.11615 0.158 0.170"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 1.57"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.11615 0.158 0.170"/>
            </geometry>
            <material name="red"/>
        </collision>
    </link>

   <link name="forearm_tube_link">
        <visual>
            <geometry>
                <cylinder radius="0.03810" length="0.490"/>
            </geometry>
            <origin xyz="0 0 0.150" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03810" length="0.490"/>
            </geometry>
            <material name="grey"/>
        </collision>
    </link>

     <link name="bracket_connection_link">
        <visual>
            <geometry>
                <box size="0.008 0.10030 0.14015"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 -1.57"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.008 0.10030 0.14015"/>
            </geometry>
            <material name="grey"/>
        </collision>
    </link>

    <link name="gripper_base_link">
        <visual>
            <geometry>
                <box size="0.04445 0.06200 0.07"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 -1.57"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.04445 0.06200 0.07"/>
            </geometry>
            <material name="grey"/>
        </collision>
    </link>


    <joint name="joint1" type="revolute">
        <parent link="base_structure_link"/>
        <child link="base_pivot_link"/>
        <origin xyz="0 0 0.1618" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="100.0" lower="-1.57" upper="1.57" velocity="1.0" />
    </joint>

    <joint name="joint2" type="revolute">
        <parent link="base_pivot_link"/>
        <child link="bicep_tube_link"/>
        <origin xyz="0 0.11645 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="100.0" lower="-0.701" upper="1.09" velocity="1.0" />
    </joint>

    <joint name="joint3" type="revolute">
        <parent link="bicep_tube_link"/>
        <child link="bicep_gearbox_link"/>
        <origin xyz="0 -0.092875 0.440" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="100.0" lower="0.0" upper="2.109" velocity="1.0" />
    </joint>
    
   <joint name="joint4" type="fixed">
        <parent link="bicep_gearbox_link"/>
        <child link="forearm_tube_link"/>
        <origin xyz="0 0 0.085" rpy="0 0 0"/>
        <axis xyz=" 0 0 1"/>
    </joint>
    
    <joint name="joint5" type="revolute">
        <parent link="forearm_tube_link"/>
        <child link="bracket_connection_link"/>
        <origin xyz="0 -0.0421 0.35" rpy="0 0 0"/>
        <axis xyz=" 0 1 0"/>
        <limit effort="100.0" lower="-1.09" upper="1.57" velocity="1.0" />
    </joint>

    <joint name="joint6" type="fixed">
        <parent link="bracket_connection_link"/>
        <child link="gripper_base_link"/>
        <origin xyz="0 0 0.085075" rpy="0 0 0"/>
    </joint>


</robot>