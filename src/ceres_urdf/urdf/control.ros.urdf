    <!--             <param name="left_wheel_name">left_wheel_joint</param> -->
    <!--             <param name="right_wheel_name">right_wheel_joint</param> -->
    <!--             <param name="loop_rate">30</param> -->
    <!--             <param name="device">/dev/ttyUSB0</param> -->
    <!--             <param name="baud_rate">57600</param> -->
    <!--             <param name="timeout">1000</param> -->
    <!--             <param name="enc_counts_per_rev">3436</param> -->
    <!--         </hardware> -->
    <!--         <joint name="left_wheel_joint"> -->
    <!--             <command_interface name="velocity"> -->
    <!--                 <param name="min">-10</param> -->
    <!--                 <param name="max">10</param> -->
    <!--             </command_interface> -->
    <!--             <state_interface name="velocity"/> -->
    <!--             <state_interface name="position"/> -->
    <!--         </joint> -->
    <!--         <joint name="right_wheel_joint"> -->
    <!--             <command_interface name="velocity"> -->
    <!--                 <param name="min">-10</param> -->
    <!--                 <param name="max">10</param> -->
    <!--             </command_interface> -->
    <!--             <state_interface name="velocity"/> -->
    <!--             <state_interface name="position"/> -->
    <!--         </joint> -->
    <!--     </ros2_control> -->
    <!-- </xacro:if> -->

    <xacro:if value="${simulation}">
        <ros2_control name="GazeboSimSystem" type="system">
            <xacro:macro name="wheel_joint" params="name">
                <joint name="${name}">
                    <command_interface name="velocity">
                        <param name="min">-10</param>
                        <param name="max">10</param>
                    </command_interface>
                    <state_interface name="velocity"/>
                    <state_interface name="position"/>
                </joint>
            </xacro:macro>

            <xacro:macro name="front_wheels" params="side">
                <xacro:macro name="front_wheel" params="orientation">
                    <xacro:property name="bar_prefix" value="front_${side}_bogey_${orientation}"/>
                    <xacro:wheel_joint name="${bar_prefix}_bar_to_wheel"/>
                </xacro:macro>

                <xacro:front_wheel orientation="forwards"/>
                <xacro:front_wheel orientation="backwards"/>
            </xacro:macro>

            <xacro:macro name="back_wheels">
                <xacro:wheel_joint name="back_bogey_left_leg_to_wheel"/>
                <xacro:wheel_joint name="back_bogey_right_leg_to_wheel"/>
            </xacro:macro>

            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>

            <xacro:front_wheels side="left"/>
            <xacro:front_wheels side="right"/>
            <xacro:back_wheels/>
        </ros2_control>

        <gazebo>
            <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
                <parameters>$(find ceres_urdf)/config/controllers.yaml</parameters>

                <publish_odom>true</publish_odom>
                <publish_odom_tf>true</publish_odom_tf>
                <publish_wheel_tf>true</publish_wheel_tf>

                <odometry_frame>odom</odometry_frame>
                <robot_base_frame>base_link</robot_base_frame>
            </plugin>
        </gazebo>
    </xacro:if>
</robot>
