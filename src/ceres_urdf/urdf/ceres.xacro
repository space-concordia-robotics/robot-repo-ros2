<?xml version="1.0"?>

<robot name="ceres_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="blue" >
        <color rgba="0 0 0.5 1"/>
    </material>

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <link name="base_structure_link">
        <visual>
            <geometry>
                <box size="0.30670 0.1600 0.135"/> 
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.30670 0.1600 0.135"/> 
            </geometry>
            <material name="blue"/>
        </collision>
    </link>

    <link name="base_pivot_link">
        <visual>
            <geometry>
                <box size="0.1633 0.1633 0.1633"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.1633 0.1633 0.1633"/>
            </geometry>
            <material name="red"/>
        </collision>
    </link>

    <link name="bicep_tube_link">
        <visual>
            <geometry>
                <cylinder radius="0.0348" length="0.520"/>
            </geometry>
            <origin xyz="0 0 0.220" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.0348" length="0.520"/>
            </geometry>
            <material name="grey"/>
        </collision>
    </link>

    <link name="bicep_gearbox_link">
        <visual>
            <geometry>
                <box size="0.11615 0.158 0.170"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.11615 0.158 0.170"/>
            </geometry>
            <material name="red"/>
        </collision>
    </link>

   <link name="forearm_tube_link">
        <visual>
            <geometry>
                <cylinder radius="0.03810" length="0.300"/>
            </geometry>
            <origin xyz="0 0 0.150" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03810" length="0.300"/>
            </geometry>
            <material name="grey"/>
        </collision>
    </link>

     <link name="bracket_connection_link">
        <visual>
            <geometry>
                <box size="0.008 0.10030 0.14015"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0 0 0"/>
            </geometry>
            <material name="grey"/>
        </collision>
    </link>

    <link name="wrist_gearbox_link">
        <visual>
            <geometry>
                <box size="0.04445 0.06200 0.07"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0 0 0"/>
            </geometry>
            <material name="grey"/>
        </collision>
    </link>

    <link name="gripper_claw_link">
        <visual>
            <geometry>
                <box size="0.033 0.14759 0.070"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.033 0.14759 0.070"/>
            </geometry>
            <material name="blue"/>
        </collision>        
    </link>
    
    <link name="right_claw_link">
        <visual>
            <geometry>
                <box size="0.033 0.073795 0.200"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.033 0.073795 0.200"/>
            </geometry>
            <material name="red"/>
        </collision>    
    </link>

    <link name="left_claw_link">
        <visual>
            <geometry>
                <box size="0.033 0.073795 0.200"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.033 0.073795 0.200"/>
            </geometry>
            <material name="red"/>
        </collision>
    </link>




    <joint name="joint1" type="continuous">
        <parent link="base_structure_link"/>
        <child link="base_pivot_link"/>
        <origin xyz="0 0 0.1618" rpy="0 0 0"/>
        <limit effort="20" velocity="2.0" lower="-2.355" upper="1.57"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="joint2" type="continuous">
        <parent link="base_pivot_link"/>
        <child link="bicep_tube_link"/>
        <origin xyz="0.11645 0 0" rpy="0 0 0"/>
        <limit effort="20" velocity="2.0" lower="-0.785" upper="2.0467"/>
    </joint>

    <joint name="joint3" type="continuous">
        <parent link="bicep_tube_link"/>
        <child link="bicep_gearbox_link"/>
        <origin xyz="-0.092875 0 0.440" rpy="0 0 0"/>
        <limit effort="20" velocity="2.0" lower="-0.466" upper="1.989"/>
        <axis xyz="1 0 0"/>
    </joint>
    
   <joint name="joint4" type="fixed">
        <parent link="bicep_gearbox_link"/>
        <child link="forearm_tube_link"/>
        <origin xyz="0 0 0.085" rpy="0 0 0"/>
        <axis xyz=" 0 0 1"/>
    </joint>
    
    <joint name="joint5" type="revolute">
        <parent link="forearm_tube_link"/>
        <child link="bracket_connection_link"/>
        <origin xyz="0.0421 0 0.3" rpy="0 0 0"/>
        <limit effort="20" velocity="2.0" lower="-1.57" upper="1.57"/>
        <axis xyz=" 1 0 0"/>
    </joint>


    <joint name="joint6" type="fixed">
        <parent link="bracket_connection_link"/>
        <child link="wrist_gearbox_link"/>
        <origin xyz="-0.026225 0 0.070075" rpy="0 0 0"/>
    </joint>

    <joint name="joint7" type="fixed">
        <parent link="wrist_gearbox_link"/>
        <child link="gripper_claw_link"/>
        <origin xyz="0.005725 0 0.07" rpy="0 0 0"/>
        <limit effort="20" velocity="2.0" lower="-3.14" upper="3.14"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="joint8" type="fixed">
        <parent link="gripper_claw_link"/>
        <child link="right_claw_link"/>
        <origin xyz="0 0.036895 0.135" rpy="0 0 0"/>
        <limit effort="20" velocity="2.0" lower="0" upper="0.0275"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="joint9" type="fixed">
        <parent link="gripper_claw_link"/>
        <child link="left_claw_link"/>
        <origin xyz="0 -0.036895 0.135" rpy="0 0 0"/>
        <limit effort="20" velocity="2.0" lower="-0.0275" upper="0"/>
        <axis xyz="0 1 0"/>
    </joint>
</robot>