<?xml version="1.0"?>
<robot name="ceres"
       xmlns="https://www.ros.org"
       xmlns:xacro="https://ros.org/wiki/xacro"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://www.ros.org ../urdf.xsd https://ros.org/wiki/xacro ../xacro.xsd">
    <xacro:arg name="mode" default="production"/>
    <xacro:arg name="control" default="ros"/>

    <xacro:property name="mode" value="$(arg mode)"/>
    <xacro:property name="production" value="${mode == 'production'}"/>
    <xacro:property name="simulation" value="${mode == 'simulation'}"/>

    <xacro:property name="control" value="$(arg control)"/>
    <xacro:property name="ros_control" value="${control == 'ros'}"/>
    <xacro:property name="gazebo_control" value="${control == 'gazebo'}"/>

    <!-- region IMU -->
    <joint name="base_to_imu" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
    </joint>

    <link name="imu_link">
        <inertial>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
    </link>

    <xacro:if value="${simulation}">
        <gazebo>
            <!-- IMU -->
            <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

            <!-- LiDAR -->
            <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
                <render_engine>ogre2</render_engine>
            </plugin>
        </gazebo>
    </xacro:if>

    <xacro:if value="${simulation}">
        <gazebo reference="imu_link">
            <sensor name="imu" type="imu">
                <always_on>1</always_on>
                <update_rate>1000</update_rate>
                <visualize>true</visualize>
                <topic>ceres/imu</topic>
                <gz_frame_id>imu_link</gz_frame_id>

                <!-- TODO 2025-09-19 (Will Free): Get the correct values for this -->
                <imu>
                    <angular_velocity>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                            </noise>
                        </z>
                    </angular_velocity>

                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>
    </xacro:if>
    <!-- endregion -->

    <!-- region Lidar -->
    <!-- TODO 2025-08-30 (Will Free): Position this properly & give it the correct dimensions -->

    <xacro:property name="lidar_height" value="0.2"/>
    <xacro:property name="lidar_radius" value="0.1"/>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="${body_length/2} 0 ${lidar_height/2}"/>
    </joint>

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
            <material name="plastic-red"/>
        </visual>
    </link>

    <xacro:if value="${simulation}">
        <gazebo reference="lidar_link">
            <sensor name="lidar" type="gpu_lidar">
                <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
                <always_on>true</always_on>
                <visualize>false</visualize>
                <update_rate>10</update_rate> <!-- 10 or 20 -->
                <topic>ceres/scan</topic>
                <gz_frame_id>lidar_link</gz_frame_id>

                <!-- <ray> -->
                <!--     <scan> -->
                <!--         <horizontal> -->
                <!--             <samples>360</samples> -->
                <!--             <resolution>1.00</resolution> -->
                <!--             <min_angle>0.00</min_angle> -->
                <!--             <max_angle>6.28</max_angle> -->
                <!--         </horizontal> -->
                <!--     </scan> -->

                <!--     <range> -->
                <!--         <min>0.12</min> -->
                <!--         <max>30</max> -->
                <!--         <resolution>0.015</resolution> -->
                <!--     </range> -->

                <!--     <noise> -->
                <!--         <type>gaussian</type> -->
                <!--         <mean>0.0</mean> -->
                <!--         <stddev>0.01</stddev> -->
                <!--     </noise> -->
                <!-- </ray> -->

                <lidar>
                    <scan>
                        <horizontal>
                            <!-- <samples>256</samples> &lt;!&ndash; 512, 1024, or 2048 &ndash;&gt; -->
                            <samples>128</samples> <!-- 512, 1024, or 2048 -->
                            <min_angle>-3.14</min_angle>
                            <max_angle>3.14</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>16</samples>
                            <min_angle>-0.2897</min_angle> <!-- -16.6° is about 0.2897 radians -->
                            <max_angle>0.2897</max_angle> <!-- +16.6° is about 0.2897 radians -->
                        </vertical>
                    </scan>

                    <range>
                        <min>0.8</min>
                        <max>50</max>
                        <resolution>0.1</resolution>
                    </range>

                    <!-- <noise> -->
                    <!--     <type>gaussian</type> -->
                    <!--     <mean>0.0</mean> -->
                    <!--     <stddev>0.01</stddev> &lt;!&ndash; from my reading of the datasheet, I think this should be like 0.02? see: range precision &ndash;&gt; -->
                    <!-- </noise> -->
                </lidar>
                <!-- <plugin filename="RosGzPointCloud" name="ros_gz_point_cloud::PointCloud"> -->
                <!--     <topic>points</topic> -->
                <!--     <frame_id>lidar_link</frame_id> -->
                <!-- </plugin> -->
            </sensor>

            <sensor name="lidar_imu" type="imu">
                <always_on>1</always_on>
                <update_rate>1000</update_rate>
                <visualize>true</visualize>
                <topic>ceres/lidar_imu</topic>
                <gz_frame_id>lidar_link</gz_frame_id>

                <!-- TODO 2025-09-19 (Will Free): Get the correct values for this -->
                <imu>
                    <angular_velocity>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <!-- <stddev>2e-4</stddev> -->
                                <!-- <bias_mean>0.0000075</bias_mean> -->
                                <!-- <bias_stddev>0.0000008</bias_stddev> -->
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <!-- <stddev>2e-4</stddev> -->
                                <!-- <bias_mean>0.0000075</bias_mean> -->
                                <!-- <bias_stddev>0.0000008</bias_stddev> -->
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <!-- <stddev>2e-4</stddev> -->
                                <!-- <bias_mean>0.0000075</bias_mean> -->
                                <!-- <bias_stddev>0.0000008</bias_stddev> -->
                            </noise>
                        </z>
                    </angular_velocity>

                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <!-- <stddev>1e-4</stddev> -->
                                <!-- <bias_mean>1e-4</bias_mean> -->
                                <!-- <bias_stddev>1e-4</bias_stddev> -->
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <!-- <stddev>1e-4</stddev> -->
                                <!-- <bias_mean>1e-4</bias_mean> -->
                                <!-- <bias_stddev>1e-4</bias_stddev> -->
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <!-- <stddev>1e-4</stddev> -->
                                <!-- <bias_mean>1e-4</bias_mean> -->
                                <!-- <bias_stddev>1e-4</bias_stddev> -->
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>
    </xacro:if>
    <!-- endregion -->
</robot>
