{
    "version": 8,
    "name": "SCRB Base Style",
    "id": "scrb-base-style",
    "metadata": {
        "maputnik:license": "https://github.com/maputnik/osm-liberty/blob/gh-pages/LICENSE.md",
        "maputnik:renderer": "mlgljs",
        "openmaptiles:version": "3.x"
    },
    "sources": {
        "openmaptiles": {
            "type": "vector",
            "url": "maptiler://sources/v3-openmaptiles"
        },
        "maptiler-satellite": {
            "type": "raster",
            "url": "maptiler://sources/satellite-v2"
        },
        "maptiler-contours": {
            "type": "vector",
            "url": "maptiler://sources/contours-v2"
        },
        "versatiles-shortbread": {
            "type": "vector",
            "tiles": [
                "https://tiles.versatiles.org/tiles/osm/{z}/{x}/{y}"
            ],
            "minzoom": 0,
            "maxzoom": 14,
            "scheme": "xyz"
        }
    },
    "sprite": "https://maputnik.github.io/osm-liberty/sprites/osm-liberty",
    "glyphs": "maptiler://fonts/{fontstack}/{range}.pbf",
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": {
                "background-color": "rgb(239,239,239)"
            },
            "layout": {
                "visibility": "none"
            }
        },
        {
            "id": "satellite",
            "type": "raster",
            "layout": {
                "visibility": "visible"
            },
            "source": "maptiler-satellite"
        },
        {
            "id": "contours",
            "type": "line",
            "source": "maptiler-contours",
            "source-layer": "contour",
            "filter": [ "all" ],
            "minzoom": 10,
            "paint": {
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    10, 0,
                    12, 0.5
                ],
                "line-color": "#333",
                "line-width": 1
            }
        },
        {
            "id": "park_outline",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "park",
            "paint": {
                "line-dasharray": [ 2, 2 ],
                "line-color": "#5FD064",
                "line-width": [
                    "interpolate",
                    [ "exponential", 2 ],
                    [ "zoom" ],
                    8, 0,
                    14, 4
                ]
            },
            "layout": {
                "visibility": "visible"
            },
            "minzoom": 8
        },
        {
            "id": "water",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "water",
            "filter": [
                "all",
                [ "!=", "brunnel", "tunnel" ]
            ],
            "paint": {
                "line-color": "#9EBDFF",
                "line-width": [
                    "interpolate",
                    [ "exponential", 2 ],
                    [ "zoom" ],
                    8, 0,
                    14, 4
                ],
                "line-dasharray": [ 2, 4 ],
                "line-opacity": 1
            },
            "layout": {
                "visibility": "visible",
                "line-cap": "round",
                "line-join": "round"
            },
            "minzoom": 8
        },
        {
            "id": "waterway_tunnel",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "waterway",
            "filter": [
                "all",
                [ "==", "brunnel", "tunnel" ]
            ],
            "paint": {
                "line-color": "#a0c8f0",
                "line-dasharray": [ 2, 4 ],
                "line-gap-width": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    12, 0,
                    20, 6
                ],
                "line-opacity": 1,
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.4 ],
                    [ "zoom" ],
                    11, 0,
                    20, 2
                ]
            },
            "layout": {
                "visibility": "none",
                "line-cap": "butt",
                "line-join": "miter"
            },
            "minzoom": 11
        },
        {
            "id": "waterway_river",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "waterway",
            "filter": [
                "all",
                [ "==", "class", "river" ],
                [ "!=", "brunnel", "tunnel" ]
            ],
            "layout": {
                "visibility": "none",
                "line-cap": "round",
                "line-join": "round"
            },
            "paint": {
                "line-color": "#a0c8f0",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    11, 0,
                    20, 3
                ],
                "line-dasharray": [ 2, 4 ]
            },
            "minzoom": 11
        },
        {
            "id": "waterway_other",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "waterway",
            "filter": [
                "all",
                [ "!=", "class", "river" ],
                [ "!=", "brunnel", "tunnel" ]
            ],
            "layout": {
                "visibility": "none",
                "line-cap": "round",
                "line-join": "round"
            },
            "paint": {
                "line-color": "#a0c8f0",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.3 ],
                    [ "zoom" ],
                    11, 0,
                    20, 3
                ],
                "line-dasharray": [ 2, 4 ]
            },
            "minzoom": 11
        },
        {
            "id": "road_service_track",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "all",
                [
                    "!in",
                    "brunnel",
                    "bridge",
                    "tunnel"
                ],
                [
                    "in",
                    "class",
                    "service",
                    "track"
                ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": "hsl(218, 5%, 90%)",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    15, 0,
                    16, 0.5,
                    20, 7.5
                ],
                "line-opacity": 0.8,
                "line-dasharray": [ 2, 6 ]
            },
            "minzoom": 15
        },
        {
            "id": "road_minor",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "all",
                [ "==", "$type", "LineString" ],
                [ "in", "class", "minor" ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": "hsl(218, 5%, 90%)",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    9, 0,
                    11, 0.5,
                    14, 3
                ],
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    12, 0,
                    13.5, 1,
                    14.5, 1,
                    15, 0
                ]
            },
            "minzoom": 12,
            "maxzoom": 15
        },
        {
            "id": "road_link_casing",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "minzoom": 13,
            "filter": [
                "all",
                [
                    "!in",
                    "class",
                    "pedestrian",
                    "path",
                    "track",
                    "service",
                    "motorway"
                ],
                [ "==", "ramp", 1 ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": "hsl(218, 5%, 60%)",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    8.5, 0,
                    9, 0.5,
                    11, 1.5,
                    14, 8
                ],
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    13, 0,
                    13.5, 1,
                    14.5, 1,
                    15, 0
                ]
            }
        },
        {
            "id": "road_link",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "minzoom": 8.5,
            "filter": [
                "all",
                [ "==", "ramp", 1 ],
                [
                    "!in",
                    "class",
                    "pedestrian",
                    "path",
                    "track",
                    "service",
                    "motorway"
                ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": "hsl(218, 5%, 90%)",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    8.5, 0,
                    11, 0.5,
                    14, 4
                ],
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    13, 0,
                    13.5, 1,
                    14.5, 1,
                    15, 0
                ]
            }
        },
        {
            "id": "road_motorway_link_casing",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "minzoom": 13,
            "filter": [
                "all",
                [ "==", "class", "motorway" ],
                [ "==", "ramp", 1 ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": "hsl(218, 5%, 60%)",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    8.5, 0,
                    9, 0.5,
                    11, 1.5,
                    14, 8
                ],
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    13, 0,
                    13.5, 1,
                    14.5, 1,
                    15, 0
                ]
            },
            "maxzoom": 15
        },
        {
            "id": "road_motorway_link",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "minzoom": 13,
            "filter": [
                "all",
                [ "==", "class", "motorway" ],
                [ "==", "ramp", 1 ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": "hsl(218, 5%, 90%)",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    8.5, 0,
                    11, 0.5,
                    14, 4
                ],
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    13, 0,
                    13.5, 1,
                    14.5, 1,
                    15, 0
                ]
            },
            "maxzoom": 15
        },
        {
            "id": "road_secondary_tertiary_casing",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "all",
                [
                    "in",
                    "class",
                    "secondary",
                    "tertiary"
                ],
                [ "!=", "ramp", 1 ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": "hsl(218, 5%, 60%)",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    8.5, 0,
                    11, 1.5,
                    14, 8
                ],
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    12, 0,
                    12.5, 1,
                    14.5, 1,
                    15, 0
                ]
            },
            "minzoom": 12,
            "maxzoom": 15
        },
        {
            "id": "road_secondary_tertiary",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "all",
                [
                    "in",
                    "class",
                    "secondary",
                    "tertiary"
                ],
                [ "!=", "ramp", 1 ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": "hsl(218, 5%, 90%)",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    8.5, 0,
                    11, 0.5,
                    14, 6
                ],
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    12, 0,
                    12.5, 1,
                    14.5, 1,
                    15, 0
                ]
            },
            "minzoom": 12,
            "maxzoom": 15
        },
        {
            "id": "road_trunk_primary_casing",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "all",
                [
                    "in",
                    "class",
                    "primary",
                    "trunk"
                ]
            ],
            "layout": {
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": "hsl(218, 5%, 60%)",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    8.5, 0,
                    9, 0.7,
                    11, 1.75,
                    14, 10
                ],
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    12, 0,
                    12.5, 1,
                    14.5, 1,
                    15, 0
                ]
            },
            "minzoom": 12,
            "maxzoom": 15
        },
        {
            "id": "road_trunk_primary",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "all",
                [
                    "in",
                    "class",
                    "primary",
                    "trunk"
                ]
            ],
            "layout": {
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": "hsl(218, 5%, 90%)",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    8.5, 0,
                    11, 0.5,
                    14, 7
                ],
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    12, 0,
                    12.5, 1,
                    14.5, 1,
                    15, 0
                ]
            },
            "minzoom": 12,
            "maxzoom": 15
        },
        {
            "id": "road_motorway_casing",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "minzoom": 6,
            "filter": [
                "all",
                [ "==", "class", "motorway" ],
                [ "!=", "ramp", 1 ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": "hsl(218, 5%, 60%)",
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    6, 0,
                    7, 2,
                    14, 10,
                    20, 24
                ],
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    6, 0,
                    7, 1
                ]
            }
        },
        {
            "id": "road_motorway",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "minzoom": 6,
            "filter": [
                "all",
                [ "==", "class", "motorway" ],
                [ "!=", "ramp", 1 ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            },
            "paint": {
                "line-color": {
                    "base": 1,
                    "stops": [
                        [ 7, "hsl(218, 5%, 60%)" ],
                        [ 8, "hsl(218, 5%, 90%)" ]
                    ]
                },
                "line-width": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    6, 0,
                    7, 1,
                    14, 8,
                    20, 20
                ],
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    6, 0,
                    7, 1
                ]
            }
        },
        {
            "id": "road_one_way_arrow",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "minzoom": 16,
            "filter": [ "==", "oneway", 1 ],
            "layout": {
                "visibility": "none",
                "icon-image": "arrow",
                "symbol-placement": "line"
            }
        },
        {
            "id": "road_one_way_arrow_opposite",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "minzoom": 16,
            "filter": [ "==", "oneway", -1 ],
            "layout": {
                "visibility": "none",
                "icon-image": "arrow",
                "symbol-placement": "line",
                "icon-rotate": 180
            }
        },
        {
            "id": "building",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "building",
            "minzoom": 13,
            "maxzoom": 14,
            "paint": {
                "fill-color": "hsl(35, 8%, 85%)",
                "fill-outline-color": {
                    "base": 1,
                    "stops": [
                        [ 13, "hsla(35, 6%, 79%, 0.32)" ],
                        [ 14, "hsl(35, 6%, 79%)" ]
                    ]
                },
                "fill-opacity": [ "literal", 1 ]
            },
            "layout": {
                "visibility": "none"
            }
        },
        {
            "id": "building-3d",
            "type": "fill-extrusion",
            "source": "openmaptiles",
            "source-layer": "building",
            "minzoom": 14,
            "paint": {
                "fill-extrusion-color": "#DCD9D6",
                "fill-extrusion-height": [
                    "get",
                    "render_height"
                ],
                "fill-extrusion-base": {
                    "property": "render_min_height",
                    "type": "identity"
                },
                "fill-extrusion-opacity": {
                    "stops": [
                        [ 12, 0 ],
                        [ 15, 0.7 ]
                    ],
                    "base": 2
                },
                "fill-extrusion-vertical-gradient": false
            },
            "layout": {
                "visibility": "visible"
            },
            "filter": [
                "none",
                [ "==", "hide_3d", 1 ]
            ]
        },
        {
            "id": "boundary-country:outline",
            "type": "line",
            "source": "versatiles-shortbread",
            "source-layer": "boundaries",
            "paint": {
                "line-opacity": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    0, 0.4,
                    4, 1
                ],
                "line-width": [
                    "interpolate",
                    [ "linear" ],
                    [ "zoom" ],
                    1, 0,
                    2, 1,
                    5, 1.2,
                    12, 3
                ],
                "line-color": "hsl(248, 1%, 80%)",
                "line-dasharray": [ 2, 4 ]
            },
            "minzoom": 1,
            "layout": {
                "visibility": "visible",
                "line-cap": "round",
                "line-join": "round"
            },
            "filter": [
                "all",
                [ "==", [ "get", "admin_level" ], 2 ],
                [ "!=", [ "get", "maritime" ], true ],
                [ "!=", [ "get", "disputed" ], true ],
                [ "!=", [ "get", "coastline" ], true ]
            ]
        },
        {
            "id": "road_label",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "transportation_name",
            "filter": [ "all" ],
            "layout": {
                "visibility": "none",
                "symbol-placement": "line",
                "text-anchor": "center",
                "text-field": "{name}",
                "text-font": [ "Roboto Regular" ],
                "text-offset": [ 0, 0.15 ],
                "text-size": {
                    "base": 1,
                    "stops": [
                        [ 13, 12 ],
                        [ 14, 13 ]
                    ]
                }
            },
            "paint": {
                "text-color": "#765",
                "text-halo-blur": 0.5,
                "text-halo-width": 1
            }
        },
        {
            "id": "road_shield",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "transportation_name",
            "minzoom": 9,
            "filter": [
                "all",
                [ "<=", "ref_length", 6 ]
            ],
            "layout": {
                "icon-image": "default_{ref_length}",
                "icon-rotation-alignment": "viewport",
                "symbol-placement": {
                    "base": 1,
                    "stops": [
                        [ 10, "point" ],
                        [ 11, "line" ]
                    ]
                },
                "symbol-spacing": 500,
                "text-field": "{ref}",
                "text-font": [ "Roboto Regular" ],
                "text-offset": [ 0, 0.1 ],
                "text-rotation-alignment": "viewport",
                "text-size": 10,
                "icon-size": 0.8,
                "visibility": "visible"
            }
        },
        {
            "id": "label-place-village",
            "type": "symbol",
            "source": "versatiles-shortbread",
            "source-layer": "place_labels",
            "filter": [
                "==",
                [ "get", "kind" ],
                "village"
            ],
            "layout": {
                "text-anchor": "bottom",
                "text-field": [ "get", "name" ],
                "text-font": [ "Roboto Regular" ],
                "text-max-width": 8,
                "text-offset": [ 0, 0 ],
                "text-size": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    7, 12,
                    12, 14
                ],
                "visibility": "visible",
                "symbol-sort-key": [
                    "-",
                    [
                        "to-number",
                        [ "get", "population" ],
                        0
                    ]
                ]
            },
            "paint": {
                "text-color": "#fff",
                "text-halo-color": "#333",
                "text-halo-width": 1.2
            },
            "minzoom": 9
        },
        {
            "id": "label-place-town",
            "type": "symbol",
            "source": "versatiles-shortbread",
            "source-layer": "place_labels",
            "filter": [
