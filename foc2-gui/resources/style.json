                        [ 0, "dot_9" ],
                        [ 8, "" ]
                    ]
                },
                "text-anchor": "bottom",
                "text-field": [ "get", "name" ],
                "text-font": [ "Roboto Regular" ],
                "text-max-width": 8,
                "text-offset": [ 0, 0 ],
                "text-size": [
                    "interpolate",
                    [ "exponential", 1.2 ],
                    [ "zoom" ],
                    7, 12,
                    12, 16
                ],
                "visibility": "visible",
                "symbol-sort-key": [
