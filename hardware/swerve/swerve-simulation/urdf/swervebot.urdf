<?xml version="1.0"?>
<!--
  URDF/Xacro model of 'swervebot': a 4-Wheel Independent Steering (4WIS) robot for Gazebo simulation.
  Includes:
    - Rectangular chassis (`base_link`)
    - 4 swerve modules (`front_left`, `front_right`, `rear_left`, `rear_right`), each with:
        * `<prefix>_steering_joint` (revolute around Z) & `<prefix>_steering_link`
        * `<prefix>_wheel_joint` (continuous around Y) & `<prefix>_wheel_link`
    - `ros2_control` hardware interface definitions for `gz_ros2_control`
-->
<robot xmlns:xacro="https://ros.org/wiki/xacro"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       name="swervebot"
       xmlns="https://www.ros.org"
       xsi:schemaLocation="https://www.ros.org ../../../../urdf.xsd https://ros.org/wiki/xacro ../../../../xacro.xsd">
    <!-- Kinematic layout parameters (must match config/controllers.yaml) -->
    <xacro:property name="wheelbase" value="1.6"/>
    <xacro:property name="track_width" value="1.2"/>

    <!-- Chassis box dimensions (meters) -->
    <xacro:property name="chassis_length" value="2.2"/>
    <xacro:property name="chassis_width" value="1.4"/>
    <xacro:property name="chassis_height" value="0.30"/>

    <!-- Drive wheel cylinder dimensions (meters) -->
    <xacro:property name="wheel_radius" value="0.25"/>
    <xacro:property name="wheel_width" value="0.16"/>

    <!-- Vertical height of the steering strut cylinder (meters) -->
    <xacro:property name="steering_height" value="0.25"/>

    <!-- Link masses (kg) -->
    <xacro:property name="chassis_mass" value="20.0"/>
    <xacro:property name="steering_mass" value="1.0"/>
    <xacro:property name="wheel_mass" value="2.0"/>

    <!-- Visual materials for RViz / Gazebo -->
    <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
    </material>

    <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <!-- Main robot chassis link -->
    <link name="base_link">
        <inertial>
            <mass value="${chassis_mass}"/>
            <inertia ixx="5.0" ixy="0" ixz="0"
                     iyy="8.0" iyz="0" izz="10.0"/>
        </inertial>

        <visual>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
    </link>

    <!--
      Macro defining a complete swerve corner module (steering link/joint + wheel link/joint).
      Parameters:
        - prefix: module identifier (e.g., front_left, front_right, rear_left, rear_right)
        - x: longitudinal offset from base_link origin (m)
        - y: lateral offset from base_link origin (m)
    -->
    <xacro:macro name="wheel_module" params="prefix x y">
        <!-- Vertical steering column link -->
        <link name="${prefix}_steering_link">
            <inertial>
                <mass value="${steering_mass}"/>
                <inertia ixx="0.01" ixy="0" ixz="0"
                         iyy="0.01" iyz="0" izz="0.01"/>
            </inertial>

            <visual>
                <geometry>
                    <cylinder radius="0.10" length="${steering_height}"/>
                </geometry>
                <material name="gray"/>
            </visual>

            <collision>
                <geometry>
                    <cylinder radius="0.10" length="${steering_height}"/>
                </geometry>
            </collision>
        </link>

        <!-- Steering joint rotating around the vertical Z axis [-pi, pi] -->
        <joint name="${prefix}_steering_joint" type="revolute">
            <parent link="base_link"/>
            <child link="${prefix}_steering_link"/>
            <origin xyz="${x} ${y} ${-chassis_height/2}"/>
            <axis xyz="0 0 1"/>
            <limit lower="${-pi}" upper="${pi}" effort="100" velocity="10"/>
            <dynamics damping="1.0" friction="0.1"/>
        </joint>

        <!-- Drive wheel link (cylinder rotated 90 deg around X so its axis aligns with Y) -->
        <link name="${prefix}_wheel_link">
            <inertial>
                <mass value="${wheel_mass}"/>
                <inertia ixx="0.02" ixy="0" ixz="0"
                         iyy="0.02" iyz="0" izz="0.02"/>
            </inertial>

            <visual>
                <origin rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black"/>
            </visual>

            <collision>
                <origin rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
        </link>

        <!-- Continuous drive wheel joint rotating around the module's Y axis -->
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="${prefix}_steering_link"/>
            <child link="${prefix}_wheel_link"/>
            <origin xyz="0 0 -${steering_height/2}"/>
            <axis xyz="0 1 0"/>
            <limit effort="100" velocity="100"/>
            <dynamics damping="0.05" friction="0.01"/>
        </joint>

        <!-- Gazebo surface friction parameters for tire-ground traction -->
        <gazebo reference="${prefix}_wheel_link">
            <!-- friction coefficients -->
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
        </gazebo>
    </xacro:macro>

    <!-- Instantiate the 4 swerve modules at the corners of the chassis -->
    <xacro:wheel_module prefix="front_left" x="${wheelbase/2}" y="${track_width/2}"/>
    <xacro:wheel_module prefix="front_right" x="${wheelbase/2}" y="${-track_width/2}"/>
    <xacro:wheel_module prefix="rear_left" x="${-wheelbase/2}" y="${track_width/2}"/>
    <xacro:wheel_module prefix="rear_right" x="${-wheelbase/2}" y="${-track_width/2}"/>

    <!-- Macro declaring ros2_control interfaces for a steering joint (position command, position+velocity state) -->
    <xacro:macro name="steering_ros2_control_joint" params="prefix">
        <joint name="${prefix}_steering_joint" type="continuous">
            <command_interface name="position">
                <!-- for now, we have no limits -->
                <!-- <param name="min">${-pi}</param> -->
                <!-- <param name="max">${pi}</param> -->
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

    <!-- Macro declaring ros2_control interfaces for a drive wheel joint (velocity command, position+velocity state) -->
    <xacro:macro name="wheel_ros2_control_joint" params="prefix">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

    <!-- ros2_control system definition binding the 8 joints to Gazebo's GazeboSimSystem hardware plugin -->
    <ros2_control name="SwerveDrive" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <xacro:steering_ros2_control_joint prefix="front_left"/>
        <xacro:steering_ros2_control_joint prefix="front_right"/>
        <xacro:steering_ros2_control_joint prefix="rear_left"/>
        <xacro:steering_ros2_control_joint prefix="rear_right"/>

        <xacro:wheel_ros2_control_joint prefix="front_left"/>
        <xacro:wheel_ros2_control_joint prefix="front_right"/>
        <xacro:wheel_ros2_control_joint prefix="rear_left"/>
        <xacro:wheel_ros2_control_joint prefix="rear_right"/>
    </ros2_control>

    <!-- Load the gz_ros2_control Gazebo plugin and pass the controller manager YAML configuration -->
    <gazebo>
        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
            <parameters>$(find swerve_simulation)/config/controllers.yaml</parameters>
        </plugin>
    </gazebo>
</robot>
